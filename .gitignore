.workbuddy/
.workbuddy/*.log

# ---- ZCode 项目记忆正本（.zcode/memory/，会话间交接用）----
.zcode/

# ---- 依赖与构建产物（第 12 周起会出现）----
node_modules/
__pycache__/
*.pyc
dist/
build/
.venv/
venv/
*.egg-info/

# ---- 本地环境配置（可能含密钥）----
.env
.env.*
!.env.example

# ---- 压缩包（提交前由 submission/ 统一生成）----
*.zip
*.7z
*.rar
